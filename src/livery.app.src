{application, livery, [
    {description, "Livery: a modern Erlang web framework over HTTP/1.1, HTTP/2, and HTTP/3"},
    {vsn, "0.10.2"},
    {registered, [livery_sup]},
    {mod, {livery_app, []}},
    {applications, [
        kernel,
        stdlib,
        ssl,
        crypto,
        public_key,
        mimerl,
        hackney,
        h1,
        h2,
        quic,
        ws,
        instrument,
        webtransport,
        barrel_mcp,
        barrel_a2a
    ]},
    %% The protocol adapters are leaf modules: nothing in livery's core
    %% calls `livery_mcp' or `livery_a2a'. Marking their libraries
    %% optional keeps a release that only serves HTTP from being forced
    %% to start two protocol stacks it never uses. OTP requires an
    %% optional application to be listed in `applications' as well.
    {optional_applications, [barrel_mcp, barrel_a2a]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/benoitc/livery"}]}
]}.
